#!/bin/sh
# Find images that look like yours: opens Pin Palette in Similar image mode.
#   findsimilar [image]
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
[ -x "$DIR/.venv/bin/python" ] || { echo "Run $DIR/install.sh first."; exit 1; }
[ -n "$1" ] && set -- "$(readlink -f "$1")"
exec "$DIR/.venv/bin/python" "$DIR/app.py" --similar "$@"
